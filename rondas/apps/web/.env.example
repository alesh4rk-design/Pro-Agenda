# Copie para .env.local. Valores do app Web em Firebase Console > Configurações do projeto.
# A apiKey do Firebase Web NÃO é segredo (identifica o projeto); a segurança vem das regras e do backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU-PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=SEU-PROJETO
VITE_FIREBASE_APP_ID=
# URL do Worker (sem barra no final).
VITE_API_URL=https://rondas-api.SEU-USUARIO.workers.dev
# Desenvolvimento local com emuladores (npm run emulators):
# VITE_USE_EMULATORS=true
# VITE_FIREBASE_PROJECT_ID=demo-rondas
# VITE_FIREBASE_API_KEY=fake-api-key
# VITE_API_URL=http://127.0.0.1:8787
